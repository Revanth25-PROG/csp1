# WhatsApp Business Cloud API Configuration
# Get these from your Meta Developer App Dashboard
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_access_token

# The phone number you want to send notifications to (with country code, e.g., 919876543210 for India)
# This could be the admin's number for testing.
ADMIN_WHATSAPP_NUMBER=your_target_phone_number
    